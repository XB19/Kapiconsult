# Copier ce fichier en « .env » à la racine du projet, puis renseigner les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub.

PGUSER=postgres
PGPASSWORD=choisissez_un_mot_de_passe
PGDATABASE=kapiconsult

# Longue chaîne aléatoire pour signer les sessions
JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire

# Administrateur créé au premier démarrage (si aucun n'existe)
ADMIN_EMAIL=admin@kapiconsult.tg
ADMIN_PASSWORD=choisissez_un_mot_de_passe_admin

# Port public du site
APP_PORT=4100
